# Servidor local do GIO
GIO_HOST=0.0.0.0
GIO_PORT=4173

# Movidesk - mantenha estes dados somente no arquivo .env.server
MOVIEDESK_TOKEN=
MOVIEDESK_REQUESTER_ID=
MOVIEDESK_API_BASE=https://api.movidesk.com/public/v1

# Classificação padrão do ticket
MOVIEDESK_TICKET_TYPE=2
MOVIEDESK_ACTION_TYPE=2
MOVIEDESK_ORIGIN=9
MOVIEDESK_STATUS=Novo
MOVIEDESK_BASE_STATUS=Novo

# O valor informado no formulário será usado quando estes campos ficarem vazios
MOVIEDESK_CATEGORY=
MOVIEDESK_URGENCY=

# Campos opcionais para direcionar o chamado à equipe de RMA
MOVIEDESK_SERVICE_FIRST_LEVEL_ID=
MOVIEDESK_OWNER_ID=
MOVIEDESK_OWNER_TEAM=
